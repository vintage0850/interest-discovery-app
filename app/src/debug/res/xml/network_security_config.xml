<?xml version="1.0" encoding="utf-8"?>
<!--
  デバッグビルド専用（app/src/debug のみ、リリースには含まれない）。
  開発機のLAN IPは環境によって変わる（Wi-Fi再接続やコンテスト会場移動で頻繁に変わり得る）ため、
  個別ドメイン列挙ではなくbase-configで平文HTTPを許可し、そのたびの修正を不要にする。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
